####################################################################
# MARKET WALL — backend configuration
#
# Copy to .env for local development. On Railway, paste these into
# the service's Variables tab instead — never commit a real key.
####################################################################

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Origins allowed to call the API. Use * locally; lock it down in production
# to the TV app's origin(s), e.g. https://wall.yourdomain.com
CORS_ORIGINS=*

# Signs device tokens. REQUIRED in production — the server refuses to start
# without it. Generate one with:  openssl rand -hex 32
TOKEN_SECRET=

# Both optional. Without them the wall still works:
#   no Redis    → quote cache is per-process and resets on deploy
#   no Postgres → pairing, watchlists and alerts are disabled
# Railway fills these in automatically when you add the plugins.
DATABASE_URL=
REDIS_URL=


####################################################################
# SAUDI — SAHMK   https://www.sahmk.sa/en/developers
####################################################################

SAHMK_API_KEY=
SAHMK_BASE_URL=https://api.sahmk.sa/api/v1

# 'delayed' on Free and Starter, 'realtime' on Pro and above.
# This is a HARD CEILING: in delayed mode the TV can never show LIVE, even if
# the upstream claims the quote is real-time. Raise it only when your contract
# actually entitles you to real-time display.
SAHMK_DATA_MODE=delayed

# Requests per day your plan allows.
#   Free 100 · Starter 5000 · Pro 50000 · Business 150000
# The engine derives its poll interval from this and holds back 30% for
# on-demand traffic (charts, search, reconnects). Getting it right is the
# difference between a smooth wall and a throttled account.
SAHMK_DAILY_BUDGET=100

# The bulk /quotes/ endpoint needs Starter or above. On Free, leave this false
# and the adapter builds the tape from the gainers/losers/volume/value lists.
SAHMK_BULK_QUOTES=false

# Real-time WebSocket needs Pro or above.
SAHMK_WEBSOCKET=false


####################################################################
# US — Twelve Data   https://twelvedata.com/pricing
####################################################################

TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com

# Their Basic plan documents real-time US equities, hence 'live'. If your
# entitlement is delayed, set this to 'delayed' and the badge follows.
TWELVEDATA_DATA_MODE=live

# Credits, not requests — one credit per symbol per refresh.
#   Basic (free) 800/day, 8/min
TWELVEDATA_DAILY_BUDGET=800
TWELVEDATA_PER_MINUTE=8

# How many US names to track. 24 symbols on the free plan lands on a refresh
# every ~17 minutes. On Grow, raise this to 60–80 and the interval drops to
# well under a minute automatically.
TWELVEDATA_SYMBOL_LIMIT=24


####################################################################
# CRYPTO — Binance public feed. Free, live, no key, no account.
####################################################################

BINANCE_ENABLED=true
BINANCE_REST_URL=https://api.binance.com/api/v3
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/!miniTicker@arr


####################################################################
# Demo mode
#
# Serves deterministic fake data for any market with no credentials. Every
# quote is stamped `simulated` and the TV badges it blue. Useful for a
# showroom or for building against a market you have not licensed yet.
# Leave this OFF in production.
####################################################################

ALLOW_SIMULATED=false
